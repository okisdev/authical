{
  "name": "authical",
  "version": "0.0.1",
  "description": "OAuth client for apps that sign in through a Better Auth OAuth provider: the device grant for desktop apps and CLIs, and access token verification for resource servers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okisdev/authical.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./device": {
      "types": "./dist/device.d.ts",
      "default": "./dist/device.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "default": "./dist/verify.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.18.0",
  "publishConfig": {
    "access": "public"
  }
}
